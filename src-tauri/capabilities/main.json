{
  "identifier": "main-capability",
  "description": "Host commands for the main control webview only",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "allow-ask",
    "allow-browser-back",
    "allow-browser-forward",
    "allow-browser-reload",
    "allow-cancel-agent-run",
    "allow-close-page",
    "allow-create-page",
    "allow-create-session",
    "allow-get-action-policy",
    "allow-get-page-snapshot",
    "allow-navigate",
    "allow-set-action-policy",
    "allow-set-active-page",
    "allow-set-provider",
    "allow-start-agent-run",
    "allow-submit-approval",
    "allow-sync-browser-viewport",
    "allow-validate-url"
  ]
}
