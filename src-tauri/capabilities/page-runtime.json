{
  "identifier": "page-runtime-capability",
  "description": "Report-only IPC for untrusted page-runtime-* webviews",
  "local": false,
  "webviews": ["page-runtime-*"],
  "remote": {
    "urls": ["about:blank", "http://*", "https://*"]
  },
  "permissions": [
    "allow-browser-runtime-report"
  ]
}
