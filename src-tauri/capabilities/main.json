{
  "identifier": "main-capability",
  "description": "Main application capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-ask",
    "allow-browser-back",
    "allow-browser-forward",
    "allow-browser-reload",
    "allow-browser-runtime-report",
    "allow-cancel-agent-run",
    "allow-close-page",
    "allow-create-page",
    "allow-create-session",
    "allow-get-action-policy",
    "allow-get-page-snapshot",
    "allow-navigate",
    "allow-set-action-policy",
    "allow-set-active-page",
    "allow-set-provider",
